# ─── Supabase (frontend) ──────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Stripe (frontend, browser-safe) ─────────────────────────────────────────
# Find this in: Stripe Dashboard → Developers → API Keys → Publishable key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# ─── Edge Function secrets ────────────────────────────────────────────────────
# These are NOT set here — they go in Supabase Dashboard:
#   Project Settings → Edge Functions → Secrets
#
# Required secrets:
#   GROQ_API_KEY            — from console.groq.com/keys
#   STRIPE_SECRET_KEY       — from Stripe Dashboard → API Keys (sk_...)
#   STRIPE_PRO_PRICE_ID     — from Stripe Dashboard → Products (price_...)
#   STRIPE_WEBHOOK_SECRET   — from Stripe Dashboard → Webhooks (whsec_...)
#   SITE_URL                — your production URL, e.g. https://yourapp.vercel.app
